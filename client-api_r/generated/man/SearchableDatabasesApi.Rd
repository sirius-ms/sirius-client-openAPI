\subsection{Method \code{RemoveDatabase()}}{
Remove a custom database from this SIRIUS instance, and optionally delete it from disk
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{SearchableDatabasesApi$RemoveDatabase(database_id, delete = FALSE, ...)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{database_id}}{id of the database to remove.}

\item{\code{delete}}{(optional) if true, the database file is deleted from disk and the data is lost. If false (the                    default), only the registration is removed and the file is kept, so the database can                    be registered again later. (default value: FALSE)}

\item{\code{...}}{Other optional arguments}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
void
}
}
